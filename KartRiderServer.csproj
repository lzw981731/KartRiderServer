<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>KartRiderServer</AssemblyName>
    <RootNamespace>KartRider</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ionic.Zlib.Core" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="KartriderLibrary/**/*.cs" />
    <Compile Include="Server/*.cs" />
    <Compile Include="Data/Profile/*.cs" />
    <Compile Include="Data/ExcData/*.cs" />
    <Compile Include="Data/Rider/*.cs" />
    <Compile Include="Data/Room/*.cs" />
    <Compile Include="Data/Event/*.cs" />
    <Compile Include="Data/KartSpec/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>